# Copy this file to `.env` and set the values from your Auth0 application. `.env` is never committed.
# Vite exposes only variables that start with VITE_ to the browser code.

VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
VITE_AUTH0_AUDIENCE=https://your-api.example.com/
